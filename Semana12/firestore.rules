// Reglas de seguridad de Cloud Firestore para Mycar.
// Se pegan en Firebase Console -> Firestore Database -> Reglas -> Publicar.
//
// Estructura:
//   usuarios/{uid}  ->  { rol: "admin" | "usuario", nombre, telefono, ciudad }   (el ID es el UID de Authentication)
//   pedidos/{id}    ->  { catalogoId, marca, modelo, precio, imagenUrl, color, estado, compradorUid, compradorCorreo, creadoEn }
//   desactivados/{marca_ID | auto_ID} -> { nombre, creadoEn }   (lo que el admin quito de la venta)
//   promociones/{id} -> { titulo, descripcion, descuento, mes, marca, activa, creadoEn }
//   horarios/{dd-MM-yyyy_HHmm} -> { uid, creadoEn }   (horario tomado; evita citas repetidas)
//   citas/{id}      ->  { autoId, autoNombre, uid, correo, fecha, hora, estado, creadoEn }
//
// Validar el rol en la app solo cambia lo que se muestra;
// lo que protege los datos de verdad son estas reglas.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // El rol se lee del documento de la persona (se crea a mano en la consola).
    function esAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Cada persona solo lee SU propio documento.
    // Al registrarse puede crear el suyo, pero SOLO con rol "usuario": nadie puede hacerse admin.
    // El admin se crea a mano en la consola. Modificar o borrar no esta permitido.
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.rol == 'usuario'
        && request.resource.data.keys().hasOnly(['rol', 'nombre', 'correo']);
      // Cada persona puede editar SOLO su nombre, telefono y ciudad. El rol no se puede tocar.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'telefono', 'ciudad']);
      allow delete: if false;
    }

    // Pedidos: los autos en venta son las marcas de la API (no se guardan aqui);
    // solo se guarda lo que cada persona compra. Crea el suyo "en proceso" (compra de prueba, sin pago real),
    // lee solo los suyos y el admin los ve todos y cambia su estado.
    match /pedidos/{pedidoId} {
      allow create: if request.auth != null
        && request.resource.data.compradorUid == request.auth.uid
        && request.resource.data.estado == 'pago_realizado';
      allow read: if request.auth != null && (resource.data.compradorUid == request.auth.uid || esAdmin());
      allow update: if esAdmin();
      allow delete: if false;
    }

    // Marcas y autos que el administrador desactivo (id "marca_448" o "auto_448-m3").
    // Todos los usuarios con sesion los leen (para no mostrarlos); solo el admin los crea y los borra.
    match /desactivados/{clave} {
      allow read: if request.auth != null;
      allow create, delete: if esAdmin();
      allow update: if false;
    }

    // Promociones (descuentos por mes): las ven todos los usuarios con sesion; solo el admin las maneja.
    match /promociones/{promoId} {
      allow read: if request.auth != null;
      allow create, update, delete: if esAdmin();
    }

    // Horarios de cita: un documento por dia y hora (id "dd-MM-yyyy_HHmm"). Se crean junto con la cita.
    // Como un documento solo se puede crear una vez, dos personas no pueden tomar el mismo horario.
    match /horarios/{horario} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && horario.matches('[0-9]{2}-[0-9]{2}-[0-9]{4}_[0-9]{4}')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'creadoEn']);
      allow update, delete: if false;
    }

    // Citas: cada persona crea y ve las suyas; el admin ve todas y las confirma.
    match /citas/{citaId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || esAdmin());
      allow update: if esAdmin();
    }
  }
}
